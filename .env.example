# ── UKSC v2 pipeline — copy to .env for local testing (never commit .env) ──────

# Neon Postgres connection string (neon.tech → your project → Connection Details)
# Must include sslmode=require (Neon shows it like that by default)
DATABASE_URL=postgres://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# my.telegram.org → API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Printed by `node scripts/login.js` (one-time)
TELEGRAM_SESSION=

# console.anthropic.com → API Keys
ANTHROPIC_KEY=sk-ant-xxx

# Shopify Dev Dashboard app credentials (Settings → Apps → Develop apps →
# "Build apps in Dev Dashboard" → your app → Settings → Credentials).
# Legacy custom apps with a directly-revealed shpat_ token were retired by
# Shopify in Jan 2026 — this app instead exchanges these for a 24h access
# token via the client credentials grant (see src/shopify-queue.js).
SHOPIFY_CLIENT_ID=xxx
SHOPIFY_CLIENT_SECRET=xxx
SHOPIFY_DOMAIN=uk-stylish.myshopify.com

# Password for the PWA login screen — pick something strong
APP_PASSWORD=change-me

# Product status when publishing: ACTIVE or DRAFT
PUBLISH_STATUS=ACTIVE

# Optional overrides
PORT=3000
